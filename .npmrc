# file: dependencies (state-recorder-sdk) install as a real copy instead of a
# symlink. Turbopack's module resolver does not follow the package's
# "exports" subpath wildcards (./lib/recorder/*, ./components/recorder/*,
# etc.) through a symlinked node_modules entry, so `next build`/`next dev`
# fail with "Module not found" for every state-recorder-sdk import even
# though Node itself resolves them fine. install-links=true makes npm copy
# the package's files into node_modules instead, which Turbopack resolves
# correctly. See README "Reusing this in another project" for context.
install-links=true
